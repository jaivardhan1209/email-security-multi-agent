# ---------------------------------------------------------------------------
# LLM layer.  provider = offline | ollama | huggingface | foundry
#   offline      -> no model required; deterministic reasoning stub (default)
#   ollama       -> local open-source model via Ollama  (recommended POC path)
#   huggingface  -> local transformers pipeline
#   foundry      -> Azure AI Foundry (future/production)
# ---------------------------------------------------------------------------
LLM_PROVIDER=offline
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=60
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Azure AI Foundry (leave blank locally; never commit real values)
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# ---------------------------------------------------------------------------
# Agent execution
# ---------------------------------------------------------------------------
AGENT_TIMEOUT_SECONDS=45
AGENT_RETRIES=1
AGENT_LLM_WEIGHT=0.4
AGENT_DETERMINISTIC_FLOOR=0.75
ENABLE_LLM_ROUTER=false

# ---------------------------------------------------------------------------
# Deterministic security policy (§4) — thresholds, not model opinions
# ---------------------------------------------------------------------------
POLICY_MALWARE_QUARANTINE=0.90
POLICY_PHISHING_QUARANTINE=0.90
POLICY_BEC_REVIEW=0.90
POLICY_SPAM_JUNK=0.85
POLICY_IMPERSONATION_REVIEW=0.80
POLICY_SUSPICIOUS_FLOOR=0.50
POLICY_COMPOSITE_QUARANTINE=1.55
POLICY_MIN_COVERAGE=0.80
POLICY_HUMAN_REVIEW=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
TRACE_FILE=
OTEL_ENABLED=false
